# deploy/stack.env.example
#
# Copy to stack.env and fill in real values. That file is gitignored
# (*.env, repo-wide) — never commit it. Names only here, no real secrets.

# Required
POSTGRES_PASSWORD=
ANTHROPIC_API_KEY=

# Optional — sensible defaults are baked into stack.yml itself, only set
# these to override.
# ARTEX_TAG=latest   # pin an exact tag (e.g. v0.1.3) for anything that matters; -rc builds never move :latest
# ARTEX_PORT=8787
# ARTEX_PROXY_PORT=8788
# ARTEX_LANG=en
# TZ=UTC

# Optional — unattended first-run setup (see README.en.md "First-run
# protection"). Leave unset to use the interactive /setup flow with the
# token printed in `docker compose logs artex` instead.
# ARTEX_SETUP_TOKEN=
# ARTEX_ADMIN_PASSWORD=

# Self-update is switched off in stack.yml (ARTEX_DISABLE_SELFUPDATE=1): the
# updater is hard-wired to a defunct third-party repo. Upgrade by changing
# ARTEX_TAG and redeploying instead.
#
# After upgrading from a build older than the 2026-10 sync: the first password
# change ends all sessions, and a fresh database needs ARTEX_SETUP_TOKEN or
# ARTEX_ADMIN_PASSWORD (or the token printed in `docker compose logs artex`).
